{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Pet",
  "version": "0.0.0",
  "identifier": "dev.trizenx.agent-pet",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Agent Pet",
        "width": 208,
        "height": 232,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
