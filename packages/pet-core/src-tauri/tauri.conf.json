{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Pet",
  "version": "0.0.0",
  "identifier": "dev.trizenx.agent-pet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Agent Pet",
        "width": 208,
        "height": 232,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/packs/**", "$HOME/.petdex/pets/**", "$HOME/.codex/pets/**"]
      }
    },
    "trayIcon": {
      "id": "pet",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": false
  }
}
