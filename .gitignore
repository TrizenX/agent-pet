node_modules/
dist/
target/
*.tsbuildinfo
.DS_Store
.env
.env.local

# Spike scratch: third-party sprite sheets are downloaded here and never
# committed. See D11 — we render other people's pets, we do not redistribute
# them.
/tmp/
*.webp
!packages/pet-core/src/packs/default/spritesheet.webp

# D11 — contact sheets and filmstrips are renderings of third-party pet art.
# Committing them to a public repo would be redistribution. Only the derived
# numbers (*.json) and FINDINGS.md are tracked; regenerate the images with
# tools/spike-atlas/.
/artifacts/**/*.png

# Generated by tauri-build on every compile.
/packages/pet-core/src-tauri/gen/schemas/
__pycache__/
*.pyc

# The Spike A placeholder frontend must be tracked even though `dist/` is
# ignored generally — M1 replaces it with a real Vite build.
!packages/pet-core/dist/
!packages/pet-core/dist/index.html
