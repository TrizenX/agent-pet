{
  "name": "agent-pet",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:no-agent-strings": "node scripts/lint-no-agent-strings.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:no-agent-strings && pnpm lint:exports && node scripts/generate-hooks-json.mjs --check && pnpm test",
    "dev": "pnpm --filter @agent-pet/pet-core dev",
    "tauri": "pnpm --filter @agent-pet/pet-core tauri",
    "hooks:generate": "node scripts/generate-hooks-json.mjs",
    "verify:rust": "cargo fmt --manifest-path packages/pet-core/src-tauri/Cargo.toml -- --check && cargo test --manifest-path packages/pet-core/src-tauri/Cargo.toml",
    "lint:exports": "node scripts/lint-exports.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
